{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "LS",
      "WebFetch",
      "WebSearch",
      "NotebookRead",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git blame:*)",
      "Bash(git fetch:*)",
      "Bash(npm list:*)",
      "Bash(npm outdated:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run build:*)",
      "Bash(npx tsc:*)",
      "Bash(pip list:*)",
      "Bash(pytest:*)",
      "Bash(mypy:*)",
      "Bash(cargo tree:*)",
      "Bash(go test:*)",
      "Bash(make check:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(which:*)",
      "Bash(echo:*)",
      "Bash(env:*)",
      "Bash(pwd:*)",
      "Bash(wc:*)",
      "Bash(ls:*)",
      "Bash(gh pr:*)",
      "Bash(cd /home/ymbo/Work/worktrees:*)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-dashes.sh",
            "if": "Bash(gh *)"
          }
        ]
      },
      {
        "matcher": "mcp__linear-server__save_comment|mcp__linear-server__save_diff_comment|mcp__shortcut__stories-create-comment|mcp__shortcut__epics-create-comment",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-dashes.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/tmux-status.sh prompt",
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/tmux-status.sh agent-start",
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/tmux-status.sh agent-stop",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/tmux-status.sh stop",
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/tmux-status.sh notify",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/tmux-status.sh end"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "code-simplifier@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "box@claude-plugins-official": true
  },
  "outputStyle": "Concise",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "dark-ansi",
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": false
}
